<robot name="twip">
    <link name="body">
        <visual>
            <origin xyz="0 0 0" rpy="0 -0 0" />
            <geometry>
                <mesh filename="meshes/twip.stl" />
            </geometry>
            <material name="body_material">
                <color rgba="0.836159 0.803167 0.618468 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 -0 0" />
            <geometry>
                <mesh filename="meshes/twip.stl" />
            </geometry>
            <material name="body_material">
                <color rgba="0.5 0.5 0.5 1.0" />
            </material>
        </collision>
        <inertial>
            <origin xyz="0.0 0.00045 0.0958" rpy="0 0 0" />
            <mass value="1.245" />
            <inertia ixx="0.007054245" ixy="0.000000529" ixz="0.000001120" iyy="0.007891076" iyz="-0.000015829" izz="0.001480266" />
        </inertial>
    </link>

    <link name="left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 -0 0" />
            <geometry>
                <mesh filename="meshes/wheel.stl" />
            </geometry>
            <material name="left_wheel_material">
                <color rgba="0.701961 0.701961 0.701961 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 -0 0" />
            <geometry>
                <mesh filename="meshes/wheel.stl" />
            </geometry>
            <material name="left_wheel_material">
                <color rgba="0.5 0.5 0.5 1.0" />
            </material>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.042" />
            <inertia ixx="0.000011812" ixy="0.0" ixz="0.0" iyy="0.000011812" iyz="0.0" izz="0.000018908" />
        </inertial>
    </link>

    <joint name="lwheel" type="revolute">
        <origin xyz="0.069 0.0 0.0" rpy="-3.14159 1.5708 0" />
        <parent link="body" />
        <child link="left_wheel" />
        <axis xyz="0 0 1" />
        <limit effort="1" velocity="20" />
        <dynamics friction="0.0" damping="600." />
    </joint>

    <link name="right_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 -0 0" />
            <geometry>
                <mesh filename="meshes/wheel.stl" />
            </geometry>
            <material name="right_wheel_material">
                <color rgba="0.701961 0.701961 0.701961 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 -0 0" />
            <geometry>
                <mesh filename="meshes/wheel.stl" />
            </geometry>
            <material name="right_wheel_material">
                <color rgba="0.5 0.5 0.5 1.0" />
            </material>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.042" />
            <inertia ixx="0.000011812" ixy="0.0" ixz="0.0" iyy="0.000011812" iyz="0.0" izz="0.000018908" />
        </inertial>
    </link>

    <joint name="rwheel" type="revolute">
        <origin xyz="-0.069 0.0 0.0" rpy="1.66533e-16 1.5708 0" />
        <parent link="body" />
        <child link="right_wheel" />
        <axis xyz="0 0 -1" />
        <limit effort="1" velocity="20" />
        <dynamics friction="0.0" damping="600." />
    </joint>


</robot>